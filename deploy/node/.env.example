# Copy to .env (ignored by Git) and set a unique local password before startup.
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=arknet
POSTGRES_DB=arknet_node
# Private local Docker network only; use verified TLS for remote databases.
PGSSLMODE=disable

# Host ports differ from standalone development; bind to loopback only.
ARKNET_UI_PORT=5174
ARKNET_AGENT_PORT=8082
ARKNET_AGENT_LOG_LEVEL=INFO

# Optional outbound enrollment; use HTTPS for a remote Core.
ARKNET_CORE_URL=
# Enable only for an explicitly configured private development HTTP endpoint.
ARKNET_CORE_ALLOW_HTTP=false

# Approved nodes heartbeat outbound. Minimum 5s; maximum 5m; default 30s.
ARKNET_HEARTBEAT_INTERVAL=30s

# ArkNet media reservation budget in whole GiB. Zero disables new selections.
# Use -1 for unlimited storage allocation. Do not also set the legacy *_BYTES setting.
# Queue only in this phase: no automatic caching or downloads are started.
ARKNET_MEDIA_STORAGE_ALLOCATION_GIB=0

# Jellyfin binds to loopback to keep the media server private to this host.
# Change the port with 127.0.0.1:<port>. Using 0.0.0.0 exposes every interface.
JELLYFIN_BIND=127.0.0.1:8096
TZ=UTC
