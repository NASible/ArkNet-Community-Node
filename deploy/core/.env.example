# Copy to .env (ignored by Git) and set a unique local password before startup.
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=arknet
POSTGRES_DB=arknet_core
# Local dedicated Docker network only; use verified TLS for remote databases.
PGSSLMODE=disable

# Keep Core on loopback; avoid standalone Core and Node development ports.
ARKNET_CORE_PORT=8083
ARKNET_CORE_LOG_LEVEL=INFO

# DEVELOPMENT ONLY: opt in to the separate administrative API.
# Generate token with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Never commit the actual token or pass it to a Node Agent.
ARKNET_CORE_DEV_ADMIN_ENABLED=false
ARKNET_CORE_DEV_ADMIN_TOKEN=

# OPTIONAL private tracker overlay. Provision a dedicated Ed25519 keypair; do
# not reuse enrollment, administrative, or TLS keys. Keep these unset for the
# base stack. See docs/private-tracker.md and compose.tracker.yaml.
# ARKNET_TRACKER_ANNOUNCE_URL=https://tracker.example.net
# ARKNET_TRACKER_SIGNING_KEY_FILE=/host/secret/path/tracker-private.key
# ARKNET_TRACKER_VERIFY_KEY_FILE=/host/config/path/tracker-public.key
# ARKNET_TRACKER_PORT=6969

# OPTIONAL Core-bound Node login overlay (compose.node-login.yaml). Use a
# dedicated Ed25519 key, never the tracker key. See
# docs/global-login-assertions.md.
# ARKNET_ASSERTION_SIGNING_KEY_FILE=/host/secret/path/assertion-private.key
# ARKNET_ASSERTION_PUBLISHED_KEYS_FILE=/host/config/path/assertion-published.keys
# ARKNET_ASSERTION_OFFLINE_WINDOW=720h

# OPTIONAL Core HTTP web-seed overlay. Combine compose.web-seed.yaml with the
# tracker overlay because both endpoints validate the same short-lived token.
# The source directory must contain only approved regular files named by opaque
# media ID and is mounted read-only. Never point it at a general media library.
# ARKNET_CORE_WEB_SEED_ORIGIN=https://core.example.net
# ARKNET_CORE_WEB_SEED_SOURCE=/host/approved/arknet-web-seed
